rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /wallets/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.admin == false
        && request.resource.data.premium == false;
      // Balance, roles, and transaction data are changed only by Admin SDK
      // inside the hardened callable function.
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'email', 'phone', 'Số điện thoại'
        ]);
      allow delete: if false;

      match /transactions/{transactionId} {
        allow read: if owner(uid);
        allow write: if false;
      }
    }
  }
}
