            android:theme="@style/Theme.AndroidSecurityLab" />

        <activity
            android:name=".ui.DataActivity"
            android:exported="false"
            android:theme="@style/Theme.AndroidSecurityLab" />

        <activity
            android:name=".ui.SavingsActivity"
            android:exported="false"
            android:theme="@style/Theme.AndroidSecurityLab" />

        <activity
            android:name=".ui.MovieActivity"
            android:exported="false"
